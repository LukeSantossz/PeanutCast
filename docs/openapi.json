  "components": {
    "schemas": {
      "Body_entrar_api_v1_auth_token_post": {
        "properties": {
          "grant_type": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^password$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Grant Type"
          },
          "username": {
            "type": "string",
            "title": "Username"
          },
          "password": {
            "type": "string",
            "format": "password",
            "title": "Password"
          },
          "scope": {
            "type": "string",
            "title": "Scope",
            "default": ""
          },
          "client_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Client Id"
          },
          "client_secret": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "format": "password",
            "title": "Client Secret"
          }
        },
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "Body_entrar_api_v1_auth_token_post"
      },
      "Clima": {
        "properties": {
          "chuva_critica_mm": {
            "type": "number",
            "maximum": 3000.0,
            "minimum": 0.0,
            "title": "Chuva Critica Mm",
            "description": "Chuva de dez a fev, em mm."
          },
          "temp_max_critica_c": {
            "type": "number",
            "maximum": 50.0,
            "minimum": 0.0,
            "title": "Temp Max Critica C",
            "description": "Máxima média de dez a fev, em °C."
          },
          "radiacao_critica_mj_m2": {
            "type": "number",
            "maximum": 40.0,
            "minimum": 0.0,
            "title": "Radiacao Critica Mj M2",
            "description": "Radiação média, em MJ/m²/dia."
          },
          "dias_calor_critica": {
            "type": "number",
            "maximum": 91.0,
            "minimum": 0.0,
            "title": "Dias Calor Critica",
            "description": "Dias acima de 35 °C de dez a fev."
          }
        },
        "type": "object",
        "required": [
          "chuva_critica_mm",
          "temp_max_critica_c",
          "radiacao_critica_mj_m2",
          "dias_calor_critica"
        ],
        "title": "Clima",
        "description": "O clima de dezembro a fevereiro, a fase crítica do amendoim.",
        "examples": [
          {
            "chuva_critica_mm": 520.0,
            "dias_calor_critica": 4.0,
            "radiacao_critica_mj_m2": 21.5,
            "temp_max_critica_c": 31.8
          }
        ]
      },
      "Decomposicao": {
        "properties": {
          "media_recente": {
            "type": "number",
            "title": "Media Recente"
          },
          "tendencia": {
            "type": "number",
            "title": "Tendencia",
            "description": "Quanto a safra fica acima da média recente com o clima médio."
          },
          "clima": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Clima",
            "description": "Contribuição de cada variável de clima."
          }
        },
        "type": "object",
        "required": [
          "media_recente",
          "tendencia",
          "clima"
        ],
        "title": "Decomposicao",
        "description": "Partes que somam a previsão, em kg/ha."
      },
      "Erro": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "Erro"
      },
      "Favoritos": {
        "properties": {
