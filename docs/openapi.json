                "$ref": "#/components/schemas/Tercil"
              },
              {
                "type": "null"
              }
            ],
            "description": "Tercil do CPTEC no município, quando há previsão sazonal."
          },
          "historico": {
            "items": {
              "$ref": "#/components/schemas/Safra"
            },
            "type": "array",
            "title": "Historico"
          }
        },
        "type": "object",
        "required": [
          "codigo",
          "nome",
          "safra",
          "cenario",
          "clima",
          "previsao",
          "faixa",
          "decomposicao",
          "cptec",
          "historico"
        ],
        "title": "Ficha"
