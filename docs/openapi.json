            "type": "string",
            "title": "Usuario"
          },
          "municipios": {
            "items": {
              "$ref": "#/components/schemas/MunicipioRef"
            },
            "type": "array",
            "title": "Municipios"
          }
        },
        "type": "object",
        "required": [
          "usuario",
          "municipios"
        ],
        "title": "Favoritos"
      },
      "Ficha": {
        "properties": {
          "codigo": {
            "type": "integer",
            "title": "Codigo"
          },
          "nome": {
            "type": "string",
            "title": "Nome"
          },
          "safra": {
            "type": "integer",
            "title": "Safra"
          },
          "cenario": {
            "type": "string",
            "enum": [
              "Seco",
              "Normal",
              "Chuvoso"
            ],
            "title": "Cenario"
          },
          "clima": {
            "$ref": "#/components/schemas/Clima"
          },
          "previsao": {
            "type": "number",
            "title": "Previsao",
            "description": "Rendimento previsto, em kg/ha."
          },
          "faixa": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Faixa",
            "description": "Previsão menos e mais o erro médio, em kg/ha."
          },
          "decomposicao": {
            "$ref": "#/components/schemas/Decomposicao"
          },
          "cptec": {
