{
  "openapi": "3.1.0",
  "info": {
    "title": "PeanutCast API",
    "description": "Previsão do rendimento de amendoim nos 24 municípios da Alta Paulista, com o mesmo modelo do painel.\n\nPara as rotas com cadeado, clique em **Authorize** e entre com o usuário e a senha do painel. O token vale 30 minutos.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/saude": {
      "get": {
        "tags": [
          "Sistema"
        ],
        "summary": "Estado da API",
        "operationId": "saude_api_v1_saude_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Saude"
                }
              }
            }
          },
          "503": {
            "description": "Dados ainda não coletados.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                },
                "example": {
                  "detail": "Sem dados: rode scripts/coletar.py e scripts/integrar.py."
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/token": {
      "post": {
        "tags": [
          "Autenticação"
        ],
        "summary": "Login",
        "description": "Troca usuário e senha do painel por um token JWT de 30 minutos.",
        "operationId": "entrar_api_v1_auth_token_post",
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/Body_entrar_api_v1_auth_token_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Token"
                }
              }
            }
          },
          "401": {
            "description": "Usuário ou senha incorretos.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                },
                "example": {
                  "detail": "Usuário ou senha incorretos."
                }
              }
            }
          },
          "429": {
            "description": "Mais de 5 tentativas no minuto.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                },
                "example": {
                  "detail": "Muitas tentativas de login. Tente de novo em instantes."
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/municipios": {
      "get": {
        "tags": [
          "Municípios"
        ],
        "summary": "Municípios e previsão nos três cenários",
        "operationId": "listar_municipios_api_v1_municipios_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListaMunicipios"
                }
              }
            }
          },
          "503": {
            "description": "Dados ainda não coletados.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                },
                "example": {
                  "detail": "Sem dados: rode scripts/coletar.py e scripts/integrar.py."
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/municipios/{codigo}": {
      "get": {
        "tags": [
          "Municípios"
        ],
        "summary": "Ficha do município",
        "description": "Previsão no cenário, faixa de erro, decomposição, tercil do CPTEC e histórico.",
        "operationId": "ficha_api_v1_municipios__codigo__get",
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "parameters": [
          {
            "name": "codigo",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "description": "Código IBGE do município.",
              "examples": [
                3500105
              ],
              "title": "Codigo"
            },
            "description": "Código IBGE do município."
          },
          {
            "name": "cenario",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "Seco",
                "Normal",
                "Chuvoso"
              ],
              "type": "string",
              "description": "Cenário de clima.",
              "default": "Normal",
              "title": "Cenario"
            },
            "description": "Cenário de clima."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ficha"
                }
              }
            }
          },
          "401": {
            "description": "Sem token, ou token vencido ou inválido.",
            "content": {
              "application/json": {
                "example": {
                  "detail": "Token inválido ou vencido."
                },
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "404": {
            "description": "Município desconhecido ou sem dados.",
            "content": {
              "application/json": {
                "example": {
                  "detail": "Município 1234567 não é atendido pelo PeanutCast."
                },
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "503": {
            "description": "Dados ainda não coletados.",
            "content": {
              "application/json": {
                "example": {
                  "detail": "Sem dados: rode scripts/coletar.py e scripts/integrar.py."
                },
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
